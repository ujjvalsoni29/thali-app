node_modules/
dist*/
# Backstop, ported from Maximus: agents building into a new folder when they cannot
# empty the real one under a mount is how a repo ends up with ten dist.stale siblings.
# The right fix is CLAUDE.md §10 (build to /tmp); these globs are the safety net.
storybook-*/
.wrangler/
*.tsbuildinfo
.idea/
.DS_Store
.dev.vars
!.dev.vars.example
# Local D1 backups (npm run db:backup, step 12). Local state, not source — and a plan
# five people rely on, so it does not belong in a repo either.
backups/
# Vite writes this next to the config on EVERY run and this mount often cannot unlink it.
vite.config.*.timestamp-*.mjs
# Generated by `npm run cf-typegen`.
worker-configuration.d.ts
